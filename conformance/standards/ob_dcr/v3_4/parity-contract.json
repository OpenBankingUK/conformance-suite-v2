    "example": {
      "schemaVersion": "1.0",
      "specification": {
        "family": "OBL_DCR",
        "scheme": "open-banking-uk",
        "name": "dynamic-client-registration",
        "version": "3.4"
      },
      "executionMode": "certification",
      "securityEnvironment": {
        "name": "Primary Authorization Server",
        "discoveryUrl": "https://aspsp.example.com/.well-known/openid-configuration",
        "clientAuthMethod": "private_key_jwt",
        "signingAlgorithm": "PS256",
        "signingPrivateKeyPath": "/secure/signing-key.pem",
        "signingKeyId": "directory-key-id",
        "mtls": {
          "enabled": true,
          "certificatePath": "/secure/transport-cert.pem",
          "privateKeyPath": "/secure/transport-key.pem",
          "caBundlePath": "/secure/ca-bundle.pem"
        }
      },
      "endpoints": [
        {
          "method": "POST",
          "path": "/register",
          "operationId": "RegisterClient",
          "required": true,
          "locked": true
        },
        {
          "method": "GET",
          "path": "/register/{ClientId}",
          "operationId": "GetClient",
          "required": false,
          "locked": false
        },
        {
          "method": "PUT",
          "path": "/register/{ClientId}",
          "operationId": "UpdateClient",
          "required": false,
          "locked": false
        },
        {
          "method": "DELETE",
          "path": "/register/{ClientId}",
          "operationId": "DeleteClient",
          "required": false,
          "locked": false
        }
      ],
      "dynamicClientRegistration": {
        "softwareStatementAssertionPath": "/secure/software-statement.jwt",
        "signingCertificatePath": "/secure/signing-cert.pem",
        "useNumericOidSubjectDn": false,
        "disableKeepAlive": false
      },
      "metadata": {
        "aspspName": "Example Bank",
        "brandName": "Example Retail",
        "environmentName": "Sandbox"
      }
    }
  },
