    "specification": {
      "id": "dynamic-client-registration",
      "displayName": "Dynamic Client Registration",
      "family": "OBL_DCR",
      "version": "3.4"
    },
    "scopeRules": {
      "scopeLocation": "endpoints",
      "resourceGroups": "forbidden",
