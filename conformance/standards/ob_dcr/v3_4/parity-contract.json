  "deviations": [
    {
      "id": "DCR-DEV-001",
      "classification": "corrected",
      "legacyDefect": "Optional GET, PUT, and DELETE capability flags are not respected by every scenario.",
      "decision": "Gate each scenario and cleanup case on every optional operation it actually invokes.",
      "justification": "DCR 3.4 makes management operations optional; unselected operations cannot be judged."
    },
    {
      "id": "DCR-DEV-002",
      "classification": "corrected",
      "legacyDefect": "Disabled scenarios or zero-step cases are reported as passing.",
      "decision": "Emit explicit SKIPPED outcomes with the missing endpoint capability as the reason.",
      "justification": "A non-executed conformance check is not evidence of a pass."
    },
    {
      "id": "DCR-DEV-003",
      "classification": "corrected",
      "legacyDefect": "Cases continue after failed prerequisites and consume missing or invalid state.",
      "decision": "Skip every dependent case and step after a prerequisite failure.",
      "justification": "Later outcomes would otherwise be misleading secondary failures or false results."
    },
    {
      "id": "DCR-DEV-004",
      "classification": "corrected",
      "legacyDefect": "Debug dumps expose compact JOSE, Authorization headers, client secrets, and token responses.",
      "decision": "Mask sensitive JOSE, authentication, client, and token evidence on every persisted or exported surface.",
      "justification": "Conformance evidence must not disclose credentials or reusable bearer material."
    },
    {
      "id": "DCR-DEV-005",
      "classification": "corrected",
      "legacyDefect": "DCR-011 decodes an expected HTTP 400 body as a successful client registration response.",
      "decision": "Keep the fourth traceable step but validate the expected DCR error response instead.",
      "justification": "An error response must not satisfy or mutate successful registration state."
    },
    {
      "id": "DCR-DEV-006",
      "classification": "strengthened",
      "legacyDefect": "Discovery accepts a merely parseable registration endpoint URL.",
      "decision": "Require an absolute HTTPS registration_endpoint.",
      "justification": "Open Banking DCR transports registration and management traffic over TLS."
    },
    {
      "id": "DCR-DEV-007",
      "classification": "strengthened",
      "legacyDefect": "Response validation contains localhost shortcuts and incomplete DCR 3.4 validation.",
      "decision": "Apply complete DCR 3.4 schema and semantic validation identically for every host.",
      "justification": "Hostnames cannot change conformance judgment; DCR 3.4 adds material response constraints."
    },
    {
      "id": "DCR-DEV-008",
      "classification": "deliberately-unsupported",
      "legacyDefect": "client_secret_post is accepted by validation even though the legacy runner cannot execute it.",
      "decision": "Support tls_client_auth, private_key_jwt, client_secret_jwt, and client_secret_basic; reject client_secret_post until execution support is intentionally added.",
      "justification": "Capability validation and executable token behavior must agree."
    },
    {
      "id": "DCR-DEV-009",
      "classification": "corrected",
      "legacyDefect": "The legacy Ozone golden output contains a schema failure while CI still passes.",
      "decision": "Parse structured results and fail verification on any failed conformance case; text or golden-file equality is insufficient.",
      "justification": "A failing conformance judgment can never be accepted as a successful live verification."
    }
  ],
