  "runtimeContract": {
    "registrationRequest": {
      "method": "POST",
      "endpoint": "discovery.registration_endpoint",
      "contentType": "application/jose",
      "accept": "application/json",
      "body": "raw compact JWS",
      "signingAlgorithm": "PS256",
      "mtls": true,
      "expectedSuccessStatus": 201,
      "expectedInvalidRequestStatus": 400
    },
    "tokenRequest": {
      "method": "POST",
      "endpoint": "discovery.token_endpoint",
      "contentType": "application/x-www-form-urlencoded",
      "grantType": "client_credentials",
      "mtls": true,
      "expectedStatus": 200,
      "generatedDependency": true,
      "executableAuthMethods": [
        "tls_client_auth",
        "private_key_jwt",
        "client_secret_jwt",
        "client_secret_basic"
      ],
      "unsupportedAuthMethods": ["client_secret_post"]
    },
    "managementRequests": {
      "endpoint": "discovery.registration_endpoint + '/' + client_id",
      "authorization": "Bearer client-credentials access token",
      "mtls": true,
      "getExpectedStatus": 200,
      "putExpectedStatus": 200,
      "deleteExpectedStatus": 204,
      "deletedOrInvalidClientExpectedStatus": 401
    },
    "statePolicy": {
      "isolation": "State is isolated per scenario and cases execute sequentially within a scenario.",
      "values": [
        "signedRegistrationJose",
        "clientId",
        "clientSecret",
        "registrationAccessToken",
        "clientCredentialsAccessToken",
        "registrationResponse"
      ],
      "prerequisiteFailure": "Skip every dependent case and step explicitly; never execute with missing or stale state.",
      "cleanup": "Cleanup is deterministic and best-effort, and cleanup failure cannot replace or hide the scenario outcome."
    },
    "evidencePolicy": {
      "alwaysMasked": [
        "softwareStatementAssertion",
        "privateKeys",
        "signedRegistrationJose",
        "clientSecret",
        "registrationAccessToken",
        "clientCredentialsAccessToken",
        "clientAssertions",
        "Authorization",
        "tokenResponse"
      ],
      "surfaces": [
        "safe plan exports",
        "reports",
        "execution logs",
        "REST responses",
        "browser downloads"
      ]
    },
    "responseValidation34": {
      "rule": "Validate the complete DCR 3.4 response schema and cross-field semantics; hostname must never weaken validation.",
      "requirements": [
        "No localhost or host-based validation bypasses.",
        "application_type accepts web or native, never the obsolete mobile value.",
        "tls_client_auth_subject_dn uses the DCR 3.4 length limit of 512 and the specified DN pattern.",
        "grant_types accepts urn:ietf:params:oauth:grant-type:jwt-bearer and enforces DCR 3.4 size and item constraints.",
        "Required fields, URI formats, JOSE algorithms, auth-method-specific fields, and response/request consistency are validated.",
        "Only token endpoint authentication methods executable by the suite can pass capability validation."
      ]
    }
  },
  "stepDefinitions": {
    "validate-registration-endpoint": {
      "kind": "assertion",
      "legacyBuilderCall": "ValidateRegistrationEndpoint",
      "behavior": "Require discovery.registration_endpoint to be an absolute HTTPS URL."
    },
    "generate-registration-jose": {
      "kind": "state",
      "legacyBuilderCall": "GenerateSignedClaims",
      "behavior": "Build and PS256-sign the DCR registration claims as compact JOSE using the configured kid and SSA.",
      "produces": ["signedRegistrationJose"],
      "sensitive": true
    },
    "post-registration": {
      "kind": "http",
      "legacyBuilderCall": "PostClientRegister",
      "behavior": "mTLS POST raw signedRegistrationJose to discovery.registration_endpoint with Content-Type application/jose and Accept application/json.",
      "consumes": ["signedRegistrationJose"],
      "produces": ["registrationResponse"],
      "sensitive": true
    },
    "assert-status-201": {
      "kind": "assertion",
      "legacyBuilderCall": "AssertStatusCodeCreated",
      "behavior": "Require HTTP 201.",
      "expectedStatus": 201
    },
    "assert-status-200": {
      "kind": "assertion",
      "legacyBuilderCall": "AssertStatusCodeOk",
      "behavior": "Require HTTP 200.",
      "expectedStatus": 200
    },
    "assert-status-400": {
      "kind": "assertion",
      "legacyBuilderCall": "AssertStatusCodeBadRequest",
      "behavior": "Require HTTP 400.",
      "expectedStatus": 400
    },
    "assert-status-401": {
      "kind": "assertion",
      "legacyBuilderCall": "AssertStatusCodeUnauthorized",
      "behavior": "Require HTTP 401.",
      "expectedStatus": 401
    },
    "parse-registration-success": {
      "kind": "state",
      "legacyBuilderCall": "ParseClientRegisterResponse",
      "behavior": "Decode a successful registration response and capture dynamic client credentials and registration metadata.",
      "consumes": ["registrationResponse"],
      "produces": ["clientId", "clientSecret", "registrationAccessToken"],
      "sensitive": true
    },
    "request-client-credentials-token": {
      "kind": "http",
      "legacyBuilderCall": "GetClientCredentialsGrant",
      "behavior": "mTLS POST a form-encoded client_credentials grant using an advertised executable auth method; require 200 and capture the access token.",
      "expectedStatus": 200,
      "consumes": ["clientId"],
      "produces": ["clientCredentialsAccessToken"],
      "sensitive": true
    },
    "delete-client": {
      "kind": "http",
      "legacyBuilderCall": "ClientDelete",
      "behavior": "mTLS DELETE registration_endpoint/client_id with the client-credentials bearer token and require 204.",
      "expectedStatus": 204,
      "consumes": ["clientId", "clientCredentialsAccessToken"]
    },
    "get-client": {
      "kind": "http",
      "legacyBuilderCall": "ClientRetrieve",
      "behavior": "mTLS GET registration_endpoint/client_id with the current bearer token.",
      "consumes": ["clientId", "clientCredentialsAccessToken"],
      "produces": ["registrationResponse"],
      "sensitive": true
    },
    "put-client": {
      "kind": "http",
      "legacyBuilderCall": "ClientUpdate",
      "behavior": "mTLS PUT raw signedRegistrationJose to registration_endpoint/client_id with Content-Type application/jose, Accept application/json, and the client-credentials bearer token.",
      "consumes": ["signedRegistrationJose", "clientId", "clientCredentialsAccessToken"],
      "produces": ["registrationResponse"],
      "sensitive": true
    },
    "validate-registration-response-34": {
      "kind": "assertion",
      "legacyBuilderCall": "AssertValidSchemaResponse",
      "behavior": "Apply the complete host-independent DCR 3.4 response validation contract."
    },
    "parse-retrieved-client": {
      "kind": "assertion",
      "legacyBuilderCall": "ParseClientRetrieveResponse",
      "behavior": "Decode the retrieved registration and check it is usable and consistent with the registered client and token endpoint.",
      "consumes": ["registrationResponse"]
    },
    "set-empty-bearer-token": {
      "kind": "state",
      "legacyBuilderCall": "SetInvalidGrantToken",
      "behavior": "Set an empty bearer access token for the negative GET request.",
      "produces": ["clientCredentialsAccessToken"],
      "sensitive": true
    },
    "validate-registration-error": {
      "kind": "assertion",
      "legacyBuilderCall": "ParseClientRegisterResponse (corrected)",
      "behavior": "Validate the expected DCR error response without decoding it as a successful client registration."
    }
  },
