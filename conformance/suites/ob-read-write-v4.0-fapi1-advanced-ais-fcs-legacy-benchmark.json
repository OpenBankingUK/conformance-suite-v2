{
  "schemaVersion": "v1",
  "name": "Open Banking Read/Write v4.0 FAPI 1 Advanced AIS FCS legacy benchmark",
  "certificationCoverage": "partial",
  "steps": [
    {
      "id": "openid-discovery",
      "name": "OpenID discovery document",
      "request": {
        "method": "GET",
        "url": "${config.discoveryUrl}"
      },
      "assertions": [
        {"type": "http_status", "expected": 200},
        {"type": "header", "name": "content-type", "rule": "contains", "value": "application/json"},
        {"type": "json_field", "path": "issuer", "rule": "string"},
        {"type": "json_field", "path": "issuer", "rule": "https_url"},
        {"type": "json_field", "path": "authorization_endpoint", "rule": "https_url"},
        {"type": "json_field", "path": "token_endpoint", "rule": "https_url"},
        {"type": "json_field", "path": "jwks_uri", "rule": "https_url"},
        {"type": "json_field", "path": "response_types_supported", "rule": "non_empty_array"},
        {"type": "json_field", "path": "response_types_supported", "rule": "min_items", "minItems": 1}
      ],
      "mandatory": true
    },
    {
      "id": "jwks-fetch",
      "name": "JWKS endpoint",
      "request": {
        "method": "GET",
        "url": "${steps.openid-discovery.response.body.jwks_uri}"
      },
      "assertions": [
        {"type": "http_status", "expected": 200},
        {"type": "header", "name": "content-type", "rule": "contains", "value": "json"},
        {"type": "json_field", "path": "keys", "rule": "array"},
        {"type": "json_field", "path": "keys", "rule": "non_empty_array"},
        {"type": "json_field", "path": "keys", "rule": "min_items", "minItems": 1},
        {"type": "json_field", "path": "keys", "rule": "all_items_have_field", "field": "kty"}
      ],
      "mandatory": true
    },
    {
      "id": "client-credentials-token",
      "name": "Client credentials token for consent setup",
      "request": {
        "method": "POST",
        "url": "${steps.openid-discovery.response.body.token_endpoint}",
        "headers": {
          "Accept": "application/json"
        },
        "body": {
          "encoding": "form",
          "fields": {
            "grant_type": "client_credentials",
            "client_id": "${config.oauth.clientId}",
            "scope": "accounts"
          }
        }
      },
      "tokenEndpointAuthPolicy": {
        "source": "fapi-signing"
      },
      "assertions": [
        {"type": "http_status", "expected": 200},
        {"type": "header", "name": "content-type", "rule": "contains", "value": "application/json"},
        {"type": "json_field", "path": "access_token", "rule": "string"},
        {"type": "json_field", "path": "token_type", "rule": "one_of", "values": ["Bearer", "bearer"]},
        {"type": "json_field", "path": "expires_in", "rule": "number"}
      ],
      "mandatory": true
    },
    {
      "id": "account-access-consent",
      "name": "Account access consent creation for legacy AIS benchmark permissions",
      "request": {
        "method": "POST",
        "url": "${config.oauth.resourceBaseUrl}/open-banking/v4.0/aisp/account-access-consents",
        "detachedJws": {
          "source": "fapi-signing"
        },
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer ${steps.client-credentials-token.response.body.access_token}"
        },
        "body": {
          "Data": {
            "Permissions": [
              "ReadAccountsBasic",
              "ReadAccountsDetail",
              "ReadBalances",
              "ReadBeneficiariesBasic",
              "ReadBeneficiariesDetail",
              "ReadDirectDebits",
              "ReadOffers",
              "ReadParty",
              "ReadPartyPSU",
              "ReadProducts",
              "ReadScheduledPaymentsBasic",
              "ReadScheduledPaymentsDetail",
              "ReadStandingOrdersBasic",
              "ReadStandingOrdersDetail",
              "ReadStatementsBasic",
              "ReadStatementsDetail",
              "ReadTransactionsBasic",
              "ReadTransactionsCredits",
              "ReadTransactionsDebits",
              "ReadTransactionsDetail"
            ]
          },
          "Risk": {}
        }
      },
      "assertions": [
        {"type": "http_status", "expected": 201},
        {"type": "header", "name": "content-type", "rule": "contains", "value": "application/json"},
        {"type": "header", "name": "x-fapi-interaction-id", "rule": "present"},
        {"type": "json_field", "path": "Data.ConsentId", "rule": "string"},
        {"type": "json_field", "path": "Data.Permissions", "rule": "array"},
        {"type": "json_field", "path": "Risk", "rule": "object"}
      ],
      "mandatory": true
    },
    {
      "kind": "psu-authorization",
      "id": "psu-authorization",
      "name": "PSU authorisation (manual)",
      "mode": "manual",
      "authorizationEndpoint": "${steps.openid-discovery.response.body.authorization_endpoint}",
      "clientId": "${config.oauth.clientId}",
      "redirectUri": "${config.oauth.redirectUri}",
      "responseType": "code id_token",
      "requestObject": {
        "source": "fapi-signing",
        "audience": "${steps.openid-discovery.response.body.issuer}",
        "openbankingIntentId": "${steps.account-access-consent.response.body.Data.ConsentId}"
      },
      "scope": "openid accounts",
      "timeoutSeconds": 180,
      "mandatory": true
    },
    {
      "id": "token-exchange",
      "name": "OAuth token exchange",
      "request": {
        "method": "POST",
        "url": "${steps.openid-discovery.response.body.token_endpoint}",
        "headers": {
          "Accept": "application/json"
        },
        "body": {
          "encoding": "form",
          "fields": {
            "grant_type": "authorization_code",
            "code": "${steps.psu-authorization.response.body.code}",
            "redirect_uri": "${config.oauth.redirectUri}",
            "client_id": "${config.oauth.clientId}"
          }
        }
      },
      "tokenEndpointAuthPolicy": {
        "source": "fapi-signing"
      },
      "assertions": [
        {"type": "http_status", "expected": 200},
        {"type": "header", "name": "content-type", "rule": "contains", "value": "application/json"},
        {"type": "json_field", "path": "access_token", "rule": "string"},
        {"type": "json_field", "path": "token_type", "rule": "one_of", "values": ["Bearer", "bearer"]},
        {"type": "json_field", "path": "expires_in", "rule": "number"}
      ],
      "mandatory": true
    },
    {
      "id": "OB-400-ACC-100400",
      "name": "OB-400-ACC-100400: bulk accounts with ReadAccountsDetail",
