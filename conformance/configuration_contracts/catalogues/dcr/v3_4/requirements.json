        "type": "required-when-capability-selected"
      },
      "statement": "When client retrieval is implemented, the ASPSP requires client-credentials authorization and mTLS and returns the registered client for the matching ClientId."
    },
    {
      "id": "dcr.v34.requirement.retrieval-unknown-client",
      "normativeReferenceIds": [
        "ob-dcr-v34.retrieval"
      ],
