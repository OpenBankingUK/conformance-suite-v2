        "capabilityId": "dcr.v34.capability.retrieval",
        "targetId": "dcr.v34.endpoint.client-retrieval",
        "targetType": "endpoint",
        "type": "required-when-capability-selected"
      },
      "statement": "Retrieval of an unknown ClientId returns 401 Unauthorized."
    },
    {
      "id": "dcr.v34.requirement.retrieval-unknown-token-revocation",
      "normativeReferenceIds": [
        "ob-dcr-v34.retrieval"
      ],
      "rule": {
        "capabilityId": "dcr.v34.capability.retrieval",
        "targetId": "dcr.v34.endpoint.client-retrieval",
        "targetType": "endpoint",
        "type": "required-when-capability-selected"
      },
      "statement": "After retrieval of an unknown ClientId, the ASPSP immediately revokes the presented access token."
    },
    {
