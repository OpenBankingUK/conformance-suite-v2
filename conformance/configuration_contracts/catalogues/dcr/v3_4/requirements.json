      "rule": {
        "capabilityId": "dcr.v34.capability.registration",
        "targetId": "dcr.v34.endpoint.registration",
        "targetType": "endpoint",
        "type": "required-when-capability-selected"
      },
      "statement": "Registration requests and responses conform to the DCR 3.4 metadata and error schemas, including Base62 issuer constraints and enumerated token endpoint authentication methods."
    },
    {
