{
  "$defs": {
    "assertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expectedStatus": {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            "id": {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
            },
            "type": {
              "const": "http-status"
            }
          },
          "required": ["id", "type", "expectedStatus"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
            },
            "schemaRef": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "response-schema"
            }
          },
          "required": ["id", "type", "schemaRef"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "headerName": {
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
              "type": "string"
            },
            "id": {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
            },
            "type": {
              "const": "header-present"
            }
          },
          "required": ["id", "type", "headerName"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedValue": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "id": {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
            },
            "jsonPointer": {
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "type": "string"
            },
            "type": {
              "const": "json-value"
            }
          },
          "required": ["id", "type", "jsonPointer", "expectedValue"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
            },
            "jsonPointer": {
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "type": "string"
            },
            "type": {
              "const": "json-absent"
            }
          },
          "required": ["id", "type", "jsonPointer"],
          "type": "object"
        }
      ]
    },
    "inputBinding": {
      "additionalProperties": false,
      "properties": {
        "inputId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "target": {
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "type": "string"
        },
        "transform": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "type": {
          "const": "json-body"
        }
      },
      "required": [
        "inputId",
        "type",
        "target",
        "transform"
      ],
      "type": "object"
    },
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "requestModification": {
      "additionalProperties": false,
      "properties": {
        "generator": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "id": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "location": {
          "enum": [
            "header",
            "detached-jws-claim",
            "detached-jws-signature",
            "json-body",
            "path-parameter"
          ]
        },
        "operation": {
          "enum": ["omit", "replace", "invalidate", "generate"]
        },
        "target": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["id", "operation", "location"],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "endpointId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "inputBindings": {
          "items": {
            "$ref": "#/$defs/inputBinding"
          },
          "type": "array"
        },
        "modifications": {
          "items": {
            "$ref": "#/$defs/requestModification"
          },
          "type": "array"
        }
      },
      "required": [
        "endpointId",
        "inputBindings",
        "modifications"
      ],
      "type": "object"
    },
    "testDefinition": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1,
          "type": "array"
        },
        "capabilityId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "coveredRequirementIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "dependencies": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "enum": ["positive", "negative", "security"]
        },
        "request": {
          "$ref": "#/$defs/request"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "purpose",
        "capabilityId",
        "coveredRequirementIds",
        "dependencies",
        "request",
        "assertions"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.openbanking.org.uk/conformance/v1/test-definition-catalogue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/documentEnvelope"
    },
    {
      "properties": {
        "documentType": {
          "const": "test-definition-catalogue"
        },
        "requirementsCatalogueId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "testDefinitions": {
          "items": {
            "$ref": "#/$defs/testDefinition"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "requirementsCatalogueId",
        "testDefinitions"
      ],
      "type": "object"
    }
  ],
  "title": "Open Banking UK conformance test-definition catalogue",
  "type": "object",
  "unevaluatedProperties": false
}
