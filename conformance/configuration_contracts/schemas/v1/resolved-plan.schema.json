{
  "$defs": {
    "finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "instancePath": {
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "relatedIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "instancePath",
        "relatedIds"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/artifactReference"
          },
          "type": "array"
        },
        "participantPlanId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "participantPlanDigest": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/sha256Digest"
        },
        "requirementsCatalogueId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "suiteReleaseId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "suiteReleaseDigest": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/sha256Digest"
        },
        "suiteReleasePublishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "suiteReleaseVersion": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/version"
        },
        "testDefinitionCatalogueId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "toolReleases": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/toolRelease"
          },
          "type": "array"
        }
      },
      "required": [
        "suiteReleaseId",
        "suiteReleaseVersion",
        "suiteReleasePublishedAt",
        "toolReleases",
        "artifacts",
        "participantPlanId",
        "participantPlanDigest",
        "suiteReleaseDigest",
        "requirementsCatalogueId",
        "testDefinitionCatalogueId"
      ],
      "type": "object"
    },
    "resolvedInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "sensitivity": {
          "enum": [
            "non-sensitive",
            "sensitive"
          ]
        },
        "source": {
          "enum": [
            "supplied",
            "inferred"
          ]
        },
        "sourceIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "value": {
          "oneOf": [
            {
              "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/frequencyValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "valueType": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        }
      },
      "required": [
        "id",
        "valueType",
        "sensitivity",
        "source",
        "sourceIds",
        "value"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "source": {
          "enum": [
            "explicit",
            "inferred",
            "dependency"
          ]
        },
        "sourceIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "source",
        "sourceIds"
      ],
      "type": "object"
    },
    "testInstance": {
      "additionalProperties": false,
      "properties": {
        "coveredRequirementIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "dependencyInstanceIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "source": {
          "enum": [
            "inferred",
            "dependency"
          ]
        },
        "sourceIds": {
          "items": {
            "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "testDefinitionId": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        }
      },
      "required": [
        "id",
        "testDefinitionId",
        "source",
        "sourceIds",
        "dependencyInstanceIds",
        "coveredRequirementIds"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.openbanking.org.uk/conformance/v1/resolved-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/documentEnvelope"
    },
    {
      "properties": {
        "applicableRequirements": {
          "items": {
            "$ref": "#/$defs/selection"
          },
          "type": "array"
        },
        "certificationEligible": {
          "type": "boolean"
        },
        "compilationAllowed": {
          "type": "boolean"
        },
        "documentType": {
          "const": "resolved-plan"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/finding"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "resolvedInputs": {
          "items": {
            "$ref": "#/$defs/resolvedInput"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "securityProfile": {
          "$ref": "https://schemas.openbanking.org.uk/conformance/v1/common.schema.json#/$defs/stableId"
        },
        "selectedCapabilities": {
          "items": {
            "$ref": "#/$defs/selection"
          },
          "type": "array"
        },
        "selectedEndpoints": {
          "items": {
            "$ref": "#/$defs/selection"
          },
          "type": "array"
        },
        "testInstances": {
          "items": {
            "$ref": "#/$defs/testInstance"
          },
          "type": "array"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "compilationAllowed",
        "certificationEligible",
        "securityProfile",
        "selectedCapabilities",
        "selectedEndpoints",
        "applicableRequirements",
        "resolvedInputs",
        "testInstances",
        "findings",
        "provenance"
      ],
      "type": "object"
    }
  ],
  "title": "Open Banking UK conformance resolved plan",
  "type": "object",
  "unevaluatedProperties": false
}
