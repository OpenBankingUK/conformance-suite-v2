{
  "schemaVersion": 2,
  "identity": {
    "pluginId": "dcr",
    "standard": "obl",
    "specification": "dynamic-client-registration",
    "securityProfile": "fapi1-advanced",
    "specificationVersion": "3.4",
    "contentHash": "sha256:computed-at-load-time"
  },
  "endpoints": [
    {
      "endpointId": "dcr.discovery.validate",
      "operation": "Discovery Validation",
      "path": "/.well-known/openid-configuration",
      "method": "GET",
      "requirement": "mandatory",
      "displayLabel": "OIDC Discovery Validation"
    },
    {
      "endpointId": "dcr.register.post",
      "operation": "Register Client",
      "path": "/register",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "POST /register"
    },
    {
      "endpointId": "dcr.register.get",
      "operation": "Retrieve Client",
      "path": "/register/{clientId}",
      "method": "GET",
      "requirement": "optional",
      "displayLabel": "GET /register/{clientId}"
    },
    {
      "endpointId": "dcr.register.put",
      "operation": "Update Client",
      "path": "/register/{clientId}",
      "method": "PUT",
      "requirement": "optional",
      "displayLabel": "PUT /register/{clientId}"
    },
    {
      "endpointId": "dcr.register.delete",
      "operation": "Delete Client",
      "path": "/register/{clientId}",
      "method": "DELETE",
      "requirement": "optional",
      "displayLabel": "DELETE /register/{clientId}"
    },
    {
      "endpointId": "dcr.token.client-credentials",
      "operation": "Client Credentials Grant",
      "path": "/token",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "POST /token (client_credentials)"
    },
    {
      "endpointId": "dcr.negative.expired-ssa",
      "operation": "Negative: Expired SSA",
      "path": "/register",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "DCR-005 Expired SSA"
    },
    {
      "endpointId": "dcr.negative.invalid-issuer",
      "operation": "Negative: Invalid Issuer",
      "path": "/register",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "DCR-007 Invalid Issuer"
    },
    {
      "endpointId": "dcr.negative.invalid-auth-method",
      "operation": "Negative: Invalid Auth Method",
      "path": "/register",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "DCR-008 Invalid Auth Method"
    },
    {
      "endpointId": "dcr.negative.wrong-response-type",
      "operation": "Negative: Wrong Response Type",
      "path": "/register",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "DCR-009 Wrong Response Type"
    },
    {
      "endpointId": "dcr.negative.deleted-client-access",
      "operation": "Negative: Deleted Client Access",
      "path": "/token",
      "method": "POST",
      "requirement": "optional",
      "displayLabel": "DCR-010 Deleted Client Access"
    },
    {
      "endpointId": "dcr.negative.wrong-client-id",
      "operation": "Negative: Wrong Client ID",
      "path": "/token",
      "method": "POST",
      "requirement": "mandatory",
      "displayLabel": "DCR-011 Wrong Client ID"
    }
  ],
  "fieldSchemas": [
    {
      "fieldId": "dcr.ssaPath",
      "displayLabel": "Software Statement Assertion path",
      "scope": "shared",
      "valueType": "path",
      "required": true,
      "sensitive": true
    },
    {
      "fieldId": "dcr.signingPrivateKeyPath",
      "displayLabel": "Signing private key path",
      "scope": "shared",
      "valueType": "path",
      "required": true,
      "sensitive": true
    },
    {
      "fieldId": "dcr.signingCertificatePath",
      "displayLabel": "Signing certificate path",
      "scope": "shared",
      "valueType": "path",
      "required": true,
      "sensitive": true
    },
    {
      "fieldId": "dcr.transportCertificatePath",
      "displayLabel": "mTLS transport certificate path",
      "scope": "shared",
      "valueType": "path",
      "required": true,
      "sensitive": true
    },
    {
      "fieldId": "dcr.transportPrivateKeyPath",
      "displayLabel": "mTLS transport private key path",
      "scope": "shared",
      "valueType": "path",
      "required": true,
      "sensitive": true
    },
    {
      "fieldId": "dcr.caBundlePath",
      "displayLabel": "Optional CA bundle path",
      "scope": "shared",
      "valueType": "path",
      "required": false,
      "sensitive": true
    },
    {
      "fieldId": "dcr.tokenEndpointAuthMethod",
      "displayLabel": "Token endpoint authentication method",
      "scope": "shared",
      "valueType": "choice",
      "required": true,
      "sensitive": false
    },
    {
      "fieldId": "dcr.disableKeepAlives",
      "displayLabel": "Disable HTTP keep-alives",
      "scope": "shared",
      "valueType": "boolean",
      "required": false,
      "sensitive": false
    }
  ],
  "runnerPrimitives": [
    {
      "primitiveId": "dcr.scenario",
      "type": "dcr-scenario",
      "description": "Execute a DCR scenario with validated credentials, mTLS transport, masked evidence, and scenario-specific assertions."
    }
  ],
  "readinessPolicy": {
    "policyId": "dcr-non-certifying-readiness-v1",
    "certificationStatus": "non-certifying",
    "omittedMandatoryOutcome": "non-certifying",
    "failedSelectedOutcome": "failed"
  },
  "masking": {
    "maskedFields": [
      "dcr.ssaPath",
      "dcr.signingPrivateKeyPath",
      "dcr.signingCertificatePath",
      "dcr.transportCertificatePath",
      "dcr.transportPrivateKeyPath",
      "dcr.caBundlePath",
      "registration_access_token",
      "client_secret",
      "access_token",
      "client_assertion"
    ],
    "evidencePaths": [
      "$.request.headers.Authorization",
      "$.request.body.client_assertion",
      "$.response.body.registration_access_token",
      "$.response.body.client_secret",
      "$.response.body.access_token"
    ]
  },
  "sourceCoverage": {
    "baselinePath": "docs/requirements/suite-coverage/migration-parity-baseline.json",
    "scenarioSource": "conformance.plugins.dcr.scenarios.ALL_SCENARIOS"
