{
  "schemaVersion": "v1",
  "name": "Grouped execution example (setup + independent execution groups)",
  "steps": [
    {
      "id": "openid-discovery",
      "name": "OpenID discovery document",
      "phase": "setup",
      "group": "bootstrap",
      "request": {
        "method": "GET",
        "url": "https://auth1.obie.uk.ozoneapi.io/.well-known/openid-configuration"
      },
      "assertions": [
        { "type": "http_status", "expected": 200 },
        { "type": "json_field", "path": "authorization_endpoint", "rule": "https_url" },
        { "type": "json_field", "path": "jwks_uri", "rule": "https_url" }
      ]
    },
    {
      "kind": "psu-authorization",
      "id": "psu-authorization",
      "name": "PSU authorisation (manual)",
      "phase": "setup",
      "group": "consent",
      "mode": "manual",
      "authorizationEndpoint": "${steps.openid-discovery.response.body.authorization_endpoint}",
      "clientId": "synthetic-client-id-00000000000000000000",
      "redirectUri": "https://conformance.example.com/callback",
      "scope": "openid accounts",
      "mandatory": true
    },
    {
      "id": "accounts-list",
      "name": "Accounts list endpoint",
      "phase": "execution",
      "group": "accounts",
      "request": {
        "method": "GET",
        "url": "https://rs1.obie.uk.ozoneapi.io/open-banking/v3.1/aisp/accounts"
      },
      "assertions": [
        { "type": "http_status", "expected": 200 }
      ]
    },
    {
      "id": "jwks-fetch",
      "name": "JWKS endpoint",
      "phase": "execution",
      "group": "metadata",
      "request": {
        "method": "GET",
        "url": "${steps.openid-discovery.response.body.jwks_uri}"
      },
      "assertions": [
        { "type": "http_status", "expected": 200 },
        { "type": "json_field", "path": "keys", "rule": "array" }
      ]
    }
  ]
}
