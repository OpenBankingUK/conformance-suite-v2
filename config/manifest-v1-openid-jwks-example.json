{
    "schemaVersion": "v1",
    "name": "Ozone OpenID discovery and JWKS smoke check (v1)",
    "certificationCoverage": "partial",
    "steps": [
        {
            "id": "openid-discovery",
            "name": "OpenID discovery document",
            "request": {
                "method": "GET",
                "url": "https://auth1.obie.uk.ozoneapi.io/.well-known/openid-configuration"
            },
            "assertions": [
                {
                    "type": "http_status",
                    "expected": 200
                },
                {
                    "type": "header",
                    "name": "content-type",
                    "rule": "contains",
                    "value": "application/json"
                },
                {
                    "type": "json_field",
                    "path": "issuer",
                    "rule": "string"
                },
                {
                    "type": "json_field",
                    "path": "issuer",
                    "rule": "https_url"
                },
                {
                    "type": "json_field",
                    "path": "authorization_endpoint",
                    "rule": "https_url"
                },
                {
                    "type": "json_field",
                    "path": "token_endpoint",
                    "rule": "https_url"
                },
                {
                    "type": "json_field",
                    "path": "jwks_uri",
                    "rule": "https_url"
                },
                {
                    "type": "json_field",
                    "path": "response_types_supported",
                    "rule": "non_empty_array"
                },
                {
                    "type": "json_field",
                    "path": "response_types_supported",
                    "rule": "min_items",
                    "minItems": 1
                }
            ]
        },
        {
            "id": "jwks-fetch",
            "name": "JWKS endpoint",
            "request": {
                "method": "GET",
                "url": "${steps.openid-discovery.response.body.jwks_uri}"
            },
            "assertions": [
                {
                    "type": "http_status",
                    "expected": 200
                },
                {
                    "type": "header",
                    "name": "content-type",
                    "rule": "contains",
                    "value": "application/json"
                },
                {
                    "type": "json_field",
                    "path": "keys",
                    "rule": "array"
                },
                {
                    "type": "json_field",
                    "path": "keys",
                    "rule": "non_empty_array"
                },
                {
                    "type": "json_field",
                    "path": "keys",
                    "rule": "min_items",
                    "minItems": 1
                },
                {
                    "type": "json_field",
                    "path": "keys",
                    "rule": "all_items_have_field",
                    "field": "kty"
                }
            ]
        }
    ]
}
