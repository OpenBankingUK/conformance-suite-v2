{
    "discoveryUrl": "https://auth1.obie.uk.ozoneapi.io/.well-known/openid-configuration",
    "timeoutSeconds": 10,
    "testTarget": {
        "standard": "obl",
        "specification": "read-write",
        "specificationVersion": "v4.0",
        "resourceGroups": ["pis"]
    },
    "oauth": {
        "clientId": "your-client-id-here",
        "redirectUri": "https://conformance.example.com/callback",
        "resourceBaseUrl": "https://resource.example.com"
    },
    "fapiSigning": {
        "signingCertificatePath": "/path/to/dummy-signing.crt",
        "signingPrivateKeyPath": "/path/to/dummy-signing.key",
        "kid": "your-signing-kid-here",
        "clientAssertionIssuer": "your-client-id-here",
        "clientAssertionSubject": "your-client-id-here",
        "tokenEndpointAuthMethod": "private_key_jwt",
        "signatureIssuer": "your-ob-org-id/your-software-statement-id",
        "signatureTrustAnchor": "openbanking.org.uk"
    },
    "openBanking": {
        "financialId": "your-aspsp-financial-id-here"
    },
    "resultOutputPath": "./out/test-results.json",
    "executionLogPath": "./out/execution-log.ndjson",
    "testData": {
        "values": {
            "creditorName": "Example Merchant",
            "remittanceInformation": "Example PIS FCS legacy benchmark run",
            "scheduledPaymentDateTime": "2026-07-17T10:00:00+00:00",
            "frequency": "EvryDay",
            "firstPaymentDateTime": "2026-07-17T10:00:00+00:00",
            "finalPaymentDateTime": "2026-08-17T10:00:00+00:00",
            "currencyOfTransfer": "EUR",
            "internationalCreditorSchemeName": "UK.OBIE.IBAN",
            "internationalCreditorIdentification": "DE89370400440532013000",
            "internationalCreditorName": "Example International Beneficiary"
        }
    }
}
