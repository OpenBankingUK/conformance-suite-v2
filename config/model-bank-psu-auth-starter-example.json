{
    "environment": "ozone-model-bank",
    "discoveryUrl": "https://auth1.obie.uk.ozoneapi.io/.well-known/openid-configuration",
    "timeoutSeconds": 10,
    "testSuite": {
        "standard": "ob-read-write",
        "specVersion": "v4.0",
        "api": "ais",
        "profile": "fapi1-advanced",
        "suite": "psu-auth-starter"
    },
    "oauth": {
